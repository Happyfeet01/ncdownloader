<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>mediafetch</id>
    <name>MediaFetch</name>
    <summary>Download manager for aria2 and yt-dlp</summary>
    <description>
MediaFetch is a download manager for Nextcloud that combines aria2 and yt-dlp in one web interface.

Features include regular HTTP/HTTPS downloads, BitTorrent and magnet downloads through aria2, and media downloads through yt-dlp. Administrators keep control over global downloader settings while every user can configure their own download folders, aria2 options and yt-dlp options.

MediaFetch is based on the original NCDownloader / Net loader project and continues its AGPL-licensed codebase.
    </description>
    <version>1.1.0</version>
    <licence>AGPL-3.0-or-later</licence>
    <author homepage="https://github.com/Happyfeet01">Happyfeet01</author>
    <author homepage="https://github.com/shiningw">Jiaxin Huang</author>
    <namespace>NCDownloader</namespace>
    <category>multimedia</category>
    <category>tools</category>
    <website>https://github.com/Happyfeet01/mediafetch</website>
    <bugs>https://github.com/Happyfeet01/mediafetch/issues</bugs>
    <repository>https://github.com/Happyfeet01/mediafetch</repository>
    <dependencies>
        <php min-version="8.2" max-version="8.4" />
        <nextcloud min-version="32" max-version="34" />
    </dependencies>
    <navigations>
        <navigation>
            <name>MediaFetch</name>
            <route>mediafetch.Main.Index</route>
            <icon>mediafetch.svg</icon>
        </navigation>
    </navigations>
    <settings>
        <admin>OCA\NCDownloader\Settings\Admin</admin>
        <personal>OCA\NCDownloader\Settings\Personal</personal>
        <admin-section>OCA\NCDownloader\Settings\AdminSection</admin-section>
        <personal-section>OCA\NCDownloader\Settings\PersonalSection</personal-section>
    </settings>
    <commands>
        <command>OCA\NCDownloader\Command\Aria2Command</command>
    </commands>
</info>
